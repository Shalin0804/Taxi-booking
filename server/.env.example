# Local MySQL:   mysql://root:password@localhost:3306/tttcabs
# TiDB Cloud:    mysql://<user>:<password>@<host>:4000/tttcabs   (and DB_SSL=true)
DATABASE_URL=
DB_SSL=false
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
