# Local MySQL:   mysql://root:password@localhost:3306/tttcabs
# TiDB Cloud:    mysql://<user>:<password>@<host>:4000/tttcabs   (and DB_SSL=true)
DATABASE_URL=
DB_SSL=false
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public site URL (used in password-reset links) and allowed browser origins (comma-separated)
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# production enables Secure cookies
NODE_ENV=development
# Proxies in front of the API (2 on Vercel + Render)
TRUST_PROXY=1
# Optional email for password resets. Without it the reset link is printed to the server log.
SMTP_URL=
MAIL_FROM=TTT Cabs <no-reply@tttcabs.com>
